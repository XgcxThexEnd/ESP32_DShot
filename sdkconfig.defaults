# Common, non-secret baseline for a fresh ESP32-S3 configuration.
#
# Layer configs/sdkconfig.dev.defaults or configs/sdkconfig.production.defaults
# after this file. Never put Wi-Fi, MQTT, certificate, or signing-key material in
# a tracked defaults file.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TLS verification must remain enabled for MQTTs and HTTPS OTA.
# CONFIG_ESP_TLS_INSECURE is not set
# CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP is not set
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_MQTT_TRANSPORT_SSL=y

# Motion or reboot behavior that could surprise an operator stays opt-in.
# CONFIG_RESTORE_FAN_STATE is not set
# CONFIG_MQTT_RESTART_ON_TIMEOUT is not set
# CONFIG_OTA_ENABLED is not set

# The common layer never enables irreversible device security. Rollback also
# stays off here and is enabled only by the production layer after its local
# health-validation implementation. Follow docs/production-deployment.md.
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
# CONFIG_NVS_ENCRYPTION is not set
# CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE is not set
