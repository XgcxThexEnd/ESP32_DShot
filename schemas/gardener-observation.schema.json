{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/esp32-dshot/gardener-observation.schema.json",
  "title": "Gardener observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "captured_at",
    "processed_at",
    "zone_id",
    "camera_id",
    "subject",
    "calibration",
    "model",
    "image",
    "quality",
    "metrics"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "observation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "captured_at": { "type": "string", "format": "date-time" },
    "processed_at": { "type": "string", "format": "date-time" },
    "zone_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "camera_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "roi"],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "roi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calibration_id", "version", "reference_visible"],
      "properties": {
        "calibration_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "reference_visible": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "version": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_key", "sha256"],
      "properties": {
        "object_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "score"],
      "properties": {
        "status": { "enum": ["ok", "uncertain", "invalid"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 240 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["uncertain", "invalid"] } } },
          "then": { "required": ["reason"] }
        }
      ]
    },
    "metrics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "confidence", "source", "source_id"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value": { "type": "number" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 32 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "enum": ["camera", "sensor", "fused"] },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      }
    }
  }
}
