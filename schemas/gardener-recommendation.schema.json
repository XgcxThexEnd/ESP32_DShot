{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/esp32-dshot/gardener-recommendation.schema.json",
  "title": "Advisory gardener recommendation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recommendation_id",
    "created_at",
    "expires_at",
    "zone_id",
    "model",
    "kind",
    "confidence",
    "evidence_observation_ids",
    "rationale",
    "requires_human_approval",
    "actuation_allowed"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "recommendation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "zone_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "version": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "kind": {
      "enum": [
        "inspect",
        "irrigation_review",
        "ventilation_review",
        "nutrient_review",
        "pest_review"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence_observation_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96,
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "suggested_fan_percentage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "suggested_duration_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "requires_human_approval": { "const": true },
    "actuation_allowed": { "const": false }
  }
}
