# Minimal non-secret CI build. It must never be flashed without reviewing the
# actual board GPIO and supplying a protected local network configuration.
CONFIG_FAN_COUNT=1
CONFIG_FAN_INDEX_START=1
CONFIG_NODE_ID="ci-safe"
CONFIG_MQTT_ROOT_TOPIC="greenhouse_esp"
# CONFIG_MQTT_LEGACY_TOPICS is not set
# CONFIG_HOME_ASSISTANT_DISCOVERY_ENABLED is not set
CONFIG_DSHOT_GPIO="5"

CONFIG_WIFI_SSID=""
CONFIG_WIFI_PASS=""
CONFIG_MQTT_BROKER_URI=""
CONFIG_MQTT_USERNAME=""
CONFIG_MQTT_PASSWORD=""

# CONFIG_MOTOR_INTERLOCK_ENABLED is not set
# CONFIG_TACH_FEEDBACK_ENABLED is not set
# CONFIG_RESTORE_FAN_STATE is not set
# CONFIG_MQTT_RESTART_ON_TIMEOUT is not set
# CONFIG_OTA_ENABLED is not set
# CONFIG_SCHEDULE_ENABLED is not set
CONFIG_SUPERVISOR_ENABLED=y
